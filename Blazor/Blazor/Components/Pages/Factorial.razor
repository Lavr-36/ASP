@page "/factorial"
@rendermode InteractiveServer

@* @using System.Numerics; *@

<h3>Factorial</h3>

<div class="factorial">
	<input type="number" @bind="limit" @bind:after="Calculate" />
	<h3>! = @factorial</h3>
</div>
<button class="btn btn-primary" @onclick="Calculate">Calculate</button>

